# Huellas — variables de entorno
# Copia este archivo a .env.local y completa los valores

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini — agente Finca La Esperanza (https://aistudio.google.com)
GEMINI_API_KEY=
# Modelo gratis recomendado: gemini-2.5-flash-lite (AI Studio free tier)
GEMINI_MODEL=gemini-2.5-flash-lite

# Blockchain — Polygon Amoy (Etapa 2)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
WALLET_PRIVATE_KEY=

NEXT_PUBLIC_HUELLAS_CONTRACT_ADDRESS=
# Alias legacy (opcional): NEXT_PUBLIC_MAGTRACE_CONTRACT_ADDRESS=

# App (URL pública para QR en producción)
NEXT_PUBLIC_APP_URL=http://localhost:3000
